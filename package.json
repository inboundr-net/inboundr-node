{
  "name": "inboundr",
  "version": "0.1.0",
  "description": "TypeScript SDK for Inboundr — inbound email for AI agents. Verify webhook signatures and call the REST API.",
  "license": "MIT",
  "author": "inboundr <dev@inboundr.net>",
  "homepage": "https://inboundr.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inboundr-net/inboundr.git"
  },
  "bugs": "https://github.com/inboundr-net/inboundr/issues",
  "keywords": [
    "email",
    "inbound-email",
    "webhook",
    "webhook-verification",
    "smtp",
    "mcp",
    "ai-agents",
    "inboundr"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node tests/webhook.test.mjs && node tests/client.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
