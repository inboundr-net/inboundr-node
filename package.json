{
  "name": "inboundr",
  "version": "0.2.2",
  "description": "Node.js SDK for the Inboundr API: receive email over signed webhooks, read and reply to it.",
  "license": "MIT",
  "author": "inboundr <dev@inboundr.net>",
  "homepage": "https://inboundr.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inboundr-net/inboundr-node.git"
  },
  "bugs": "https://github.com/inboundr-net/inboundr-node/issues",
  "keywords": [
    "email",
    "inbound-email",
    "webhook",
    "webhook-verification",
    "smtp",
    "mcp",
    "ai-agents",
    "inboundr"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run spec:check && npm run build && node tests/webhook.test.mjs && node tests/client.test.mjs && node tests/spec.test.mjs && tsc -p tests/tsconfig.json",
    "spec:sync": "node scripts/spec.mjs sync",
    "spec:types": "node scripts/spec.mjs types",
    "spec:check": "node scripts/spec.mjs check",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "js-yaml": "4.3.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
